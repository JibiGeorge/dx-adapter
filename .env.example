# dx-adapter - Environment Configuration Example
# Copy this to .env.local for local development (never commit real secrets)

# ─── Core ──────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Security ──────────────────────────────────────────────────────────────────
# Generate a strong random key: node -e "   require('crypto').randomBytes(32).toString('hex'))"
API_KEY=REPLACE_WITH_STRONG_KEY

# Comma-separated allowed origins for CORS (leave empty to allow all in dev)
# ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
# Max requests per client within TTL window
RATE_LIMIT_MAX=60
# Window duration in seconds
RATE_LIMIT_TTL=60

# ─── Logging ───────────────────────────────────────────────────────────────────
# Log levels: fatal | error | warn | log | debug | verbose
# Production recommended: log
# Development recommended: debug
LOG_LEVEL=debug

# Service name tag included in every log entry
SERVICE_NAME=dx-adapter

# Log HTTP requests (true | false)
LOG_HTTP_REQUESTS=true

# Log health check endpoint requests (true | false, default false)
LOG_HEALTH_CHECK=false

# Enable request body logging (disabled by default for security)
LOG_HTTP_REQUEST_BODY=false

# Enable response body logging (disabled by default for security)
LOG_HTTP_RESPONSE_BODY=false

# ─── MongoDB ───────────────────────────────────────────────────────────────────
# Full MongoDB connection URI — supports replica sets, SRV, and directConnection
# Format: mongodb://[user]:[password]@[host]:[port]?[options]
# Format (SRV): mongodb+srv://[user]:[password]@[cluster]
CONFIG_MONGO_URL=mongodb://localhost:27017

# Database name to connect to
CONFIG_MONGO_DB=dx_adapter_config

# Collection name that holds tenant configuration documents
CONFIG_MONGO_COLLECTION=tenant_config

JWT_SECRET=REPLACE_WITH_STRONG_JWT_SECRET

# ─── DMS (Document Management System) Microservice ────────────────────────────
# Base URL for Document Management Service
DMS_HOST_URL=http://coredms.medibuddy.in/

# MediBuddy application ID and URL headers passed to DMS
MB_APP_ID=9192
MB_APP_URL=https://portal.medibuddy.in/

# ─── Coverage Letter / Portal Applications ────────────────────────────────────
# Application ID used for printing coverage letters and reports
APPLICATION_ID=9240